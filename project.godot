; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Reference",
"class": "Game",
"language": "GDScript",
"path": "res://Objects/ClassGame.gd"
} ]
_global_script_class_icons={
"Game": ""
}

[application]

config/name="Project Alpha"
run/main_scene="res://Scenes/Main.tscn"
config/icon="res://icon.png"

[autoload]

gl="*res://Scripts/Global.gd"
PluginSettings="*res://addons/github-integration/scripts/PluginSettings.gd"
UserData="*res://addons/github-integration/scripts/user_data.gd"
IconLoaderGithub="*res://addons/github-integration/scripts/IconLoaderGithub.gd"
RestHandler="*res://addons/github-integration/scripts/RestHandler.gd"

[display]

window/size/height=640

[editor_plugins]

enabled=PoolStringArray( "res://addons/Todo_Manager/plugin.cfg" )

[gdnative]

singletons=[  ]

[physics]

common/enable_pause_aware_picking=true

[rendering]

environment/default_environment="res://default_env.tres"
