[sub_resource type="GDScript" id=1]
script/source = "extends Control


export (PackedScene) var meny


func _ready():
	if gl.pl_died:
		$Label.text = \"Вы проиграли!\"
	else:
		$Label.text = \"Вы выйграли!\"


func _on_Go_to_meny_pressed():
	get_tree().change_scene_to(meny)


func _on_Close_game_pressed():
	get_tree().quit()
"

