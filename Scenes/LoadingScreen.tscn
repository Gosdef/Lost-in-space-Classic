[sub_resource type="GDScript" id=2]
script/source = "extends Control

export (PackedScene) var meny

func _on_GoToGame_timeout():
	$Game.visible = true

func _on_ShowTime_timeout():
	$Timer.text = str(int($Timer.text) - 1)

func _on_Game_pressed():
	get_tree().change_scene_to(meny)
"

